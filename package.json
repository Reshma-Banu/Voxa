{
  "name": "voxa",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "bun --cwd apps/web run dev",
    "build:web": "bun --cwd apps/web run build",
    "check:web": "bun --cwd apps/web run check",
    "dev:api": "cd apps/api && uvicorn main:app --reload --host 0.0.0.0 --port 8000"
  }
}
